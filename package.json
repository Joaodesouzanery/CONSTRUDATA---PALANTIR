{
  "name": "construdata-360",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:prerender",
    "build:prerender": "vite build --ssr src/prerender.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "lint": "eslint .",
    "check:segredos": "node scripts/checar-segredos-no-bundle.mjs dist",
    "test:processos": "node --experimental-strip-types --test src/features/processos/*.test.ts src/features/processos/core/*.test.ts src/features/processos/core/sintetico/*.test.ts src/features/processos/demo/*.test.ts",
    "test": "node --import ./scripts/testes/resolver-ts.mjs --test \"src/**/*.test.ts\"",
    "fixture:processos": "node --experimental-strip-types scripts/gerar-fixture-demo-processos.ts",
    "seed:processos": "node --experimental-strip-types scripts/semear-processos.ts",
    "verify:processos": "node --experimental-strip-types scripts/verificar-processos.ts",
    "discover:processos": "node --experimental-strip-types scripts/materializar-descoberta-processos.ts",
    "qa:medicao-xlsx": "node scripts/qa_medicao_xlsx.mjs --write docs/qa-medicao-xlsx-snapshot.json",
    "qa:controle-caixa": "node --import ./scripts/testes/resolver-ts.mjs scripts/qa/qa-controle-caixa.mjs",
    "qa:fcp": "node --import ./scripts/testes/resolver-ts.mjs scripts/qa/qa-fcp.mjs",
    "qa:funcionarios": "node --import ./scripts/testes/resolver-ts.mjs scripts/qa/qa-funcionarios.mjs",
    "qa:rdo-wcr": "node --import ./scripts/testes/resolver-ts.mjs scripts/qa/qa-rdo-wcr.mjs",
    "fixture:funcionarios": "node scripts/gerar-fixture-funcionarios.mjs",
    "preview": "vite preview",
    "video:preview": "npm.cmd --prefix videos run preview",
    "video:render:hero": "npm.cmd --prefix videos run render:hero",
    "video:render:demo": "npm.cmd --prefix videos run render:demo",
    "video:render:linkedin": "npm.cmd --prefix videos run render:linkedin",
    "video:render:explainer": "npm.cmd --prefix videos run render:explainer",
    "video:render:torre": "npm.cmd --prefix videos run render:torre",
    "video:render:launch": "npm.cmd --prefix videos run render:launch",
    "video:render:launch:landing": "npm.cmd --prefix videos run render:launch:landing",
    "video:render:launch:vertical": "npm.cmd --prefix videos run render:launch:vertical",
    "video:publish:hero": "powershell -NoProfile -Command \"npm.cmd --prefix videos run render:hero; New-Item -ItemType Directory -Force public/videos | Out-Null; Copy-Item -LiteralPath videos/out/hero-loop.mp4 -Destination public/videos/hero-loop.mp4 -Force\"",
    "ocr:preparar": "node scripts/copiar-ocr.mjs",
    "prebuild": "node scripts/copiar-ocr.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@supabase/supabase-js": "^2.102.1",
    "@types/qrcode": "^1.5.6",
    "@xyflow/react": "^12.11.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "date-fns": "^4.1.0",
    "elkjs": "^0.12.0",
    "jspdf": "^4.2.1",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.577.0",
    "pdfjs-dist": "^5.5.207",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.13.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
}
